# Server
PORT=3000
BASE_URL=http://localhost:3000

# Upload
# Gambar  -> upload/image/  (kompresi otomatis di atas 7 MB)
MAX_FILE_SIZE_MB=20

# Video & audio -> upload/video/ dan upload/audio/ (tanpa kompresi)
MAX_MEDIA_FILE_SIZE_MB=50

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Lokasi penyimpanan (opsional, default: ./upload)
# UPLOAD_DIR=/var/www/uploads